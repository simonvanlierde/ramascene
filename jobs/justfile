# The image records the engine commit it was built from.
export ENGINE_COMMIT := `git -C .. rev-parse HEAD 2>/dev/null || echo unknown`
export ENGINE_BRANCH := `git -C .. branch --show-current 2>/dev/null || echo unknown`

# List the recipes.
default:
    @just --list

# Lint, format check, types, tests.
check:
    uv run ruff check
    uv run ruff format --check
    uv run ty check
    uv run pytest

# Fix what ruff can fix, then format.
fmt:
    uv run ruff check --fix
    uv run ruff format

# Serve on 127.0.0.1:8020 (HOST and PORT override), outside Docker.
serve:
    uv run ramascene-jobs

# Build and start the service in Docker. Needs DATASETS_DIR.
up:
    docker compose -p ramascene_jobs up -d --build --wait

# Stop it and remove the containers.
down:
    docker compose -p ramascene_jobs down

# Follow the service logs.
logs:
    docker compose -p ramascene_jobs logs -f
